/* ========== 画面を返す ========== */
function doGet(e) {
  const names = ['Index', 'index', 'Index.html', 'index.html'];
  let t = null;
  for (let i = 0; i < names.length && !t; i++) {
    try { t = HtmlService.createTemplateFromFile(names[i]); } catch (err) { /* 次の名前を試す */ }
  }
  if (!t) {
    return HtmlService.createHtmlOutput(
      '<div style="font-family:sans-serif;padding:24px;line-height:1.8">' +
      '<h2>画面のファイルが見つかりません</h2>' +
      '<p>Apps Script の左の「ファイル」に、名前が <b>Index.html</b> のファイルがあるか確認してください。</p>' +
      '<p>直したあとは「デプロイ → デプロイを管理 → 鉛筆マーク → バージョン：新バージョン → デプロイ」で反映します。</p></div>'
    ).setTitle(APP_NAME);
  }
  t.apiUrl = ScriptApp.getService().getUrl() || '';
  t.guestKey = (e && e.parameter && e.parameter.guest) ? String(e.parameter.guest).replace(/[^0-9a-zA-Z]/g, '') : '';
  return t.evaluate()
    .setTitle(APP_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/* ========== 画面からの呼び出しの受付（fetch） ========== */
const API = {
  requestCode: requestCode, verifyCode: verifyCode, logout: logout,
  getBoot: getBoot, getProject: getProject, sync: sync, saveRows: saveRows, deleteRows: deleteRows,
  saveRow: saveRow, deleteRow: deleteRow, saveTTConfig: saveTTConfig,
  shareCreate: shareCreate, shareStop: shareStop, importForm: importForm,
  guestGet: guestGet, guestSave: guestSave,
  getForms: getForms,
  getAdmin: getAdmin, saveUser: saveUser, saveGroup: saveGroup, deleteGroup: deleteGroup,
  savePjMember: savePjMember, removePjMember: removePjMember, saveProjectInfo: saveProjectInfo,
  createProject: createProject, saveTools: saveTools, setAutoImport: setAutoImport
};
function doPost(e) {
  let out;
  try {
    const req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    const f = API[req.fn];
    if (!f) throw new Error('不明な操作です：' + req.fn);
    out = { ok: true, result: f.apply(null, req.args || []) };
  } catch (err) {
    out = { ok: false, error: String((err && err.message) || err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

