      target: p['集客目標'] === '' ? '' : Number(p['集客目標']) || 0, state: String(p['状態'] || ''),
      urlGuest: String(p[FORM_COL.guest] || ''), urlStaff: String(p[FORM_COL.staff] || ''), urlSurvey: String(p[FORM_COL.survey] || '')
    },
    tools: getTools_(), choices: getChoices_(), pages: PAGES,
    autoImport: ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'syncAllForms'; })
  };
}
function saveUser(token, pjId, u) {
  const me = admin_(token, pjId).me;
  const email = String(u.email || '').trim().toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('メールアドレスの形を確認してください。');
  upsertBy_('ユーザー', { 'メールアドレス': email }, { 'メールアドレス': email, '名字': String(u.last || ''), '名前': String(u.first || ''), '区分': String(u.kind || 'メンバー'), '有効／無効': u.active === '無効' ? '無効' : '有効' }, me);
  return getAdmin(token, pjId);
}
function saveGroup(token, pjId, g) {
  const me = admin_(token, pjId).me;
  const name = String(g.name || '').trim();
  if (!name) throw new Error('グループ名を入力してください。');
  const obj = { 'グループ名': name, 'メールアドレス': String(g.emails || '').split(/[\s,、]+/).filter(String).join(', ') };
  PAGES.forEach(function (x) { obj[x] = (g.pages && g.pages[x]) ? 'TRUE' : 'FALSE'; });
  obj['ホーム'] = 'TRUE';
  upsertBy_('権限', { 'グループ名': g.oldName || name }, obj, me);
  return getAdmin(token, pjId);
}
function deleteGroup(token, pjId, name) {
  const me = admin_(token, pjId).me;
  removeBy_('権限', { 'グループ名': name }, me);
  return getAdmin(token, pjId);
}
function savePjMember(token, pjId, email, role) {
  pjId = String(pjId);
  const me = admin_(token, pjId).me;
  email = String(email || '').trim().toLowerCase();
  if (!findUser_(email)) throw new Error('先に「ユーザー」にこのメールアドレスを登録してください。');
  upsertBy_('PJメンバー', { 'PJ ID': pjId, 'メールアドレス': email }, { 'PJ ID': pjId, 'メールアドレス': email, '役割': String(role || '') }, me);
  return getAdmin(token, pjId);
}
function removePjMember(token, pjId, email) {
  pjId = String(pjId);
  const me = admin_(token, pjId).me;
  removeBy_('PJメンバー', { 'PJ ID': pjId, 'メールアドレス': email }, me);
  return getAdmin(token, pjId);
}
function projectObj_(info) {
  return {
    '名前': String(info.name || ''), 'クライアント': String(info.client || ''), '種別': String(info.kind || ''),
    '本番日': String(info.date || ''), '集客目標': info.target === '' || info.target === undefined ? '' : Math.max(0, Number(info.target) || 0),
    '状態': String(info.state || '進行中'),
    '参加者申込フォームの回答シートURL': String(info.urlGuest || ''), '運営メンバー申込フォームの回答シートURL': String(info.urlStaff || ''),
    'アンケートフォームの回答シートURL': String(info.urlSurvey || '')
  };
}
function saveProjectInfo(token, pjId, info) {
  pjId = String(pjId);
  const me = admin_(token, pjId).me;
  const obj = projectObj_(info || {}); obj['PJ ID'] = pjId;
  upsertBy_('プロジェクト', { 'PJ ID': pjId }, obj, me);
  return getAdmin(token, pjId);
}
function createProject(token, pjId, info) {
  const me = admin_(token, pjId).me;
  if (!String((info || {}).name || '').trim()) throw new Error('プロジェクト名を入力してください。');
  const ids = readTable_('プロジェクト').map(function (p) { const m = String(p['PJ ID']).match(/(\d+)$/); return m ? Number(m[1]) : 0; });
  const newId = 'PJ' + String((ids.length ? Math.max.apply(null, ids) : 0) + 1).padStart(3, '0');
  const obj = projectObj_(info); obj['PJ ID'] = newId; if (!info.state) obj['状態'] = '準備中';
  upsertBy_('プロジェクト', { 'PJ ID': newId }, obj, me);
  upsertBy_('PJメンバー', { 'PJ ID': newId, 'メールアドレス': me.email }, { 'PJ ID': newId, 'メールアドレス': me.email, '役割': me.staff ? '社員（担当）' : 'PL' }, me);
  return { newId: newId };
}
function saveTools(token, pjId, tools) {
  admin_(token, pjId);
  const t = {};
  ['design', 'submit', 'drawing'].forEach(function (k) { t[k] = { name: String((tools[k] || {}).name || ''), url: String((tools[k] || {}).url || '') }; });
  PropertiesService.getScriptProperties().setProperty('TOOLS', JSON.stringify(t));
  return getAdmin(token, pjId);
}
function setAutoImport(token, pjId, on) {
  admin_(token, pjId);
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'syncAllForms') ScriptApp.deleteTrigger(t); });
  if (on) ScriptApp.newTrigger('syncAllForms').timeBased().everyHours(1).create();
  return getAdmin(token, pjId);
}
