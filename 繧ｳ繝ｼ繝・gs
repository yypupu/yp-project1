/** キー（列の値）で1行を追加・更新する（ユーザー・権限・PJメンバー・プロジェクト用） */
function upsertBy_(sheetName, key, obj, me) {
  return withLock_(function () {
    const sh = sheet_(sheetName);
    const data = sh.getDataRange().getValues();
    const head = headOf_(data);
    const kcols = Object.keys(key).map(function (k) { return head.indexOf(k); });
    let r = -1;
    for (let i = 1; i < data.length && r < 0; i++) {
      if (Object.keys(key).every(function (k, n) { return String(norm_(data[i][kcols[n]])).trim().toLowerCase() === String(key[k]).trim().toLowerCase(); })) r = i;
    }
    const before = r >= 0 ? data[r] : null;
    const row = head.map(function (h, j) { return (h in obj) ? toCell_(obj[h]) : (before ? before[j] : ''); });
    const changes = diff_(head, before, row, head.filter(function (h) { return !(h in obj); }));
    if (r >= 0) sh.getRange(r + 1, 1, 1, head.length).setValues([row]);
    else sh.getRange(data.length + 1, 1, 1, head.length).setValues([row]);
    if (r < 0 || changes.length) log_(me, sheetName, Object.keys(key).map(function (k) { return key[k]; }).join(' / '), r >= 0 ? '更新' : '追加', changes.join(' ／ '));
    invalidate_(sheetName, null);
    return true;
  });
}
function removeBy_(sheetName, key, me) {
  return withLock_(function () {
    const sh = sheet_(sheetName);
    const data = sh.getDataRange().getValues();
    const head = headOf_(data);
    for (let i = data.length - 1; i >= 1; i--) {
      if (Object.keys(key).every(function (k) { return String(norm_(data[i][head.indexOf(k)])).trim().toLowerCase() === String(key[k]).trim().toLowerCase(); })) {
        sh.deleteRow(i + 1);
        log_(me, sheetName, Object.keys(key).map(function (k) { return key[k]; }).join(' / '), '削除', '');
      }
    }
    invalidate_(sheetName, null);
    return true;
  });
}

/** あるプロジェクトの行を全部入れ替える（タイテ設定・タイテ列・共有リンク用） */
function replaceRows_(sheetName, pjId, objs, me) {
  return withLock_(function () {
