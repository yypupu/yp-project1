/* ========== ログイン ========== */
function findUser_(email) {
  email = String(email || '').trim().toLowerCase();
  return readTable_('ユーザー').find(function (u) { return String(u['メールアドレス']).trim().toLowerCase() === email; }) || null;
}

function requestCode(email) {
  email = String(email || '').trim().toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { ok: false, msg: 'メールアドレスの形を確認してください。' };
  const u = findUser_(email);
  if (!u) return { ok: false, msg: 'このメールアドレスは登録されていません。管理者に「ユーザー」シートへの登録を頼んでください。' };
  if (u['有効／無効'] === '無効') return { ok: false, msg: 'このアカウントは無効になっています。管理者に確認してください。' };
  const cache = CacheService.getScriptCache();
  if (cache.get('wait:' + email)) return { ok: false, msg: 'さっきコードを送りました。メールを確認するか、1分ほど待ってからもう一度押してください。' };
  // 同じアドレスへの送信は1時間に CODE_PER_HOUR 回まで（いたずらでメールの上限を使い切られないように）
  const now = Date.now();
  let sent = [];
  try { sent = JSON.parse(cache.get('rate:' + email) || '[]'); } catch (e) { sent = []; }
  sent = sent.filter(function (t) { return now - t < 3600000; });
  if (sent.length >= CODE_PER_HOUR) {
    const mins = Math.max(1, Math.ceil((sent[0] + 3600000 - now) / 60000));
    return { ok: false, msg: 'このメールアドレスへのコードの送信は、1時間に' + CODE_PER_HOUR + '回までです。あと' + mins + '分ほどで送れるようになります。届いたメール（迷惑メールフォルダも）をもう一度確認してください。' };
  }
  sent.push(now);
  cache.put('rate:' + email, JSON.stringify(sent), 3600);
  const code = String(Math.floor(100000 + Math.random() * 900000));
  cache.put('code:' + email, code, CODE_MINUTES * 60);
  cache.put('try:' + email, '0', CODE_MINUTES * 60);
  cache.put('wait:' + email, '1', 60);
  MailApp.sendEmail({
    to: email,
    subject: '【' + APP_NAME + '】ログインコード ' + code,
    body: u['名字'] + 'さん\n\nログインコード：' + code + '\n\n' + CODE_MINUTES + '分以内にアプリの画面に入力してください。\n心当たりがない場合は、このメールを無視してください。\n\n' + APP_NAME
  });
  return { ok: true };
}

function verifyCode(email, code) {
  email = String(email || '').trim().toLowerCase();
  code = String(code || '').replace(/\D/g, '');
  const cache = CacheService.getScriptCache();
  const right = cache.get('code:' + email);
  if (!right) return { ok: false, msg: 'コードの期限が切れました。もう一度コードを送ってください。' };
  const tries = Number(cache.get('try:' + email) || 0) + 1;
  if (tries > 5) { cache.remove('code:' + email); return { ok: false, msg: '間違いが続いたので、コードを無効にしました。もう一度コードを送ってください。' }; }
  cache.put('try:' + email, String(tries), CODE_MINUTES * 60);
  if (code !== right) return { ok: false, msg: 'コードが違います。メールに書かれた6桁の数字を確認してください。' };
  cache.remove('code:' + email);
  const token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
  PropertiesService.getScriptProperties().setProperty('s:' + token, JSON.stringify({ email: email, exp: Date.now() + SESSION_DAYS * 86400000 }));
  return { ok: true, token: token };
}

function me_(token) {
  if (!token) throw new Error('LOGIN');
  if (MEMO_['#me:' + token]) return MEMO_['#me:' + token];
  try { const hit = cache_().get('me:' + token); if (hit) return (MEMO_['#me:' + token] = JSON.parse(hit)); } catch (e) { /* 読み直す */ }
  const me = meRaw_(token);
  MEMO_['#me:' + token] = me;
  try { cache_().put('me:' + token, JSON.stringify(me), 120); } catch (e) { /* 何もしない */ }
  return me;
}
function meRaw_(token) {
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty('s:' + token);
  if (!raw) throw new Error('LOGIN');
  const s = JSON.parse(raw);
  if (s.exp < Date.now()) { props.deleteProperty('s:' + token); throw new Error('LOGIN'); }
  const u = findUser_(s.email);
  if (!u || u['有効／無効'] === '無効') throw new Error('LOGIN');
  const kind = String(u['区分'] || '');
  return { email: s.email, name: String(u['名字'] || ''), given: String(u['名前'] || ''), kind: kind, staff: STAFF_KINDS.indexOf(kind) >= 0 };
}

function logout(token) {
  if (token) { PropertiesService.getScriptProperties().deleteProperty('s:' + token); try { cache_().remove('me:' + token); } catch (e) { /* 何もしない */ } }
  return true;
}

function cleanupSessions() {
  const p = PropertiesService.getScriptProperties();
  const all = p.getProperties();
  Object.keys(all).forEach(function (k) {
    if (k.indexOf('s:') !== 0) return;
    try { if (JSON.parse(all[k]).exp < Date.now()) p.deleteProperty(k); } catch (e) { p.deleteProperty(k); }
  });
}

