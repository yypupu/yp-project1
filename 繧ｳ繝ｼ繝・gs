/** 最初に1回実行する：必要なシートと列があるか確認し、許可を取る */
function setup() {
  const ss = SpreadsheetApp.getActive();
  PropertiesService.getScriptProperties().setProperty('SS_ID', ss.getId());
  const need = {
    'ユーザー': ['メールアドレス', '名字', '名前', '区分', '有効／無効'],
    '権限': ['グループ名', 'メールアドレス'].concat(PAGES),
    'プロジェクト': ['PJ ID', '名前', 'クライアント', '種別', '本番日', '集客目標', '状態', '参加者申込フォームの回答シートURL', '運営メンバー申込フォームの回答シートURL', 'アンケートフォームの回答シートURL'],
    'PJメンバー': ['PJ ID', 'メールアドレス', '役割'],
    '共有リンク': ['PJ ID', '合言葉', '有効期限', '有効／停止'],
    'タイテ設定': ['PJ ID', 'タイトル', 'ページ番号', '開始時刻', '終了時刻', '1時間の高さ', '基本の文字サイズ'],
    'タイテ列': ['PJ ID', '順番', '列名', 'グループ', '幅'],
    '変更ログ': ['日時', 'メールアドレス', 'シート', 'ID', '操作', '変更内容']
  };
  Object.keys(TABLES).forEach(function (k) {
    const t = TABLES[k];
    need[t.sheet] = ['ID', 'PJ ID'].concat(Object.keys(t.fields).map(function (f) { return t.fields[f]; }));
  });
  const problems = [], added = [];
  Object.keys(need).forEach(function (name) {
    let sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name);
      sh.getRange(1, 1, 1, need[name].length).setValues([need[name]]).setFontWeight('bold').setBackground('#FFE699');
      sh.setFrozenRows(1);
      added.push('シートを作成：' + name);
      return;
    }
    const last = Math.max(1, sh.getLastColumn());
    const head = sh.getRange(1, 1, 1, last).getValues()[0].map(function (h) { return String(h).trim(); });
    const miss = need[name].filter(function (h) { return head.indexOf(h) < 0; });
    if (miss.length) {
      const startCol = head.join('') === '' ? 1 : last + 1;
      sh.getRange(1, startCol, 1, miss.length).setValues([miss]).setFontWeight('bold').setBackground('#FFE699');
      added.push('「' + name + '」に列を追加：' + miss.join('、'));
    }
  });
  MailApp.getRemainingDailyQuota();       // メール送信の許可
  ScriptApp.getProjectTriggers();         // 自動取り込み（時間で動かす）の許可
  if (ss.getSpreadsheetTimeZone() !== 'Asia/Tokyo') problems.push('スプレッドシートの「ファイル → 設定 → タイムゾーン」を「(GMT+09:00) 東京」にしてください（今：' + ss.getSpreadsheetTimeZone() + '）');
  try { FormApp.getActiveForm(); } catch (e) { /* Googleフォームを読むための許可 */ }
  const msg = (added.length ? '足りなかったものを自動で追加しました：\n' + added.join('\n') + '\n\n' : '') +
    (problems.length ? '直してほしい点があります：\n' + problems.join('\n') : 'OK：必要なシートと列がそろっています。');
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { Logger.log(msg); }
}

/* ========== シートの読み書き ========== */
/* 速さのための工夫：
 *  ・スプレッドシートは1回の呼び出しで1回だけ開く（SS_）
 *  ・同じシートは1回の呼び出しで1回だけ読む（MEMO_）
 *  ・ユーザー／権限などあまり変わらないシートは5分間キャッシュ（SHARED_）。手で編集したら onEdit で消す
 *  ・データが変わったかは「版（ver）」で判断し、変わっていなければシートを読まない（sync） */
let SS_ = null;
const MEMO_ = {};
const SHARED_ = ['ユーザー', '権限', 'PJメンバー', 'プロジェクト', '共有リンク', 'タイテ設定', 'タイテ列'];
function ss_() {
  if (SS_) return SS_;
  const id = PropertiesService.getScriptProperties().getProperty('SS_ID');
  SS_ = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActive();
  return SS_;
}
function cache_() { return CacheService.getScriptCache(); }
/** シートを書き換えたら呼ぶ：キャッシュを消して「版」を進める */
function invalidate_(name, pjId) {
  delete MEMO_[name];
  try {
    const c = cache_();
    c.remove('t:' + name);
    if (name === '選択肢') c.remove('choices');
    c.put('v:' + (pjId || '*'), String(Date.now()) + Math.random().toString(36).slice(2, 6), 21600);
  } catch (e) { /* キャッシュが使えなくても動く */ }
}
/** 今のデータの版（全体の版＋プロジェクトの版） */
function ver_(pjId) {
  const c = cache_(), keys = ['v:*', 'v:' + pjId];
  const got = c.getAll(keys);
  keys.forEach(function (k) { if (!got[k]) { got[k] = String(Date.now()); c.put(k, got[k], 21600); } });
  return got['v:*'] + '.' + got['v:' + pjId];
}
/** シートを手で編集したとき（スプレッドシート側）：キャッシュを消して、画面に「変わった」と知らせる */
function onEdit(e) {
  try {
    const name = e.range.getSheet().getName();
    const c = CacheService.getScriptCache();
    c.removeAll(['t:' + name, 'choices']);
    c.put('v:*', String(Date.now()), 21600);
  } catch (err) { /* 何もしない */ }
}

/** セルの値を画面で扱いやすい形（文字）にそろえる */
function norm_(v) {
  if (v instanceof Date) {
    if (v.getFullYear() < 1901) return Utilities.formatDate(v, tz_(), 'HH:mm');
    const hm = Utilities.formatDate(v, tz_(), 'HH:mm');
    return Utilities.formatDate(v, tz_(), hm === '00:00' ? 'yyyy-MM-dd' : 'yyyy-MM-dd HH:mm');
  }
  if (v === true) return 'TRUE';
  if (v === false) return 'FALSE';
  return v === null || v === undefined ? '' : v;
}

/** 画面から来た値をセルに入れる値にする（日付の形なら日付に、数は数に） */
function toCell_(v) {
  if (v instanceof Date || typeof v === 'number') return v;
  const s = String(v === null || v === undefined ? '' : v);
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m) return Utilities.parseDate(s, tz_(), 'yyyy-MM-dd');
  return s;
}
/** 時刻は文字として保存する（シートの時刻のずれを防ぐため、先頭に ' を付ける） */
function timeCell_(v) {
  const m = String(v || '').match(/^(\d{1,2}):(\d{2})/);
  return m ? "'" + String(m[1]).padStart(2, '0') + ':' + m[2] : '';
}

/** シートを「見出し名 → 値」のオブジェクトの配列として読む */
function readTable_(name) {
  if (MEMO_[name]) return MEMO_[name];
  const shared = SHARED_.indexOf(name) >= 0;
  if (shared) {
    try { const hit = cache_().get('t:' + name); if (hit) { MEMO_[name] = JSON.parse(hit); return MEMO_[name]; } } catch (e) { /* 読み直す */ }
  }
  const out = readTableRaw_(name);
  MEMO_[name] = out;
  if (shared) { try { const j = JSON.stringify(out); if (j.length < 95000) cache_().put('t:' + name, j, 300); } catch (e) { /* 入らなければ毎回読む */ } }
  return out;
}
function readTableRaw_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('シート「' + name + '」が見つかりません。');
  return tableFromValues_(sh.getDataRange().getValues());
}
function tableFromValues_(data) {
  const values = data.slice();
  const head = values.shift().map(function (h) { return String(h).trim(); });
  const out = [];
  values.forEach(function (r, i) {
    if (!r.some(function (c) { return c !== '' && c !== null; })) return;
    const o = { _row: i + 2 };
    head.forEach(function (h, j) { if (h) o[h] = norm_(r[j]); });
    out.push(o);
  });
  return out;
}
function readTableSafe_(name) { try { return readTable_(name); } catch (e) { return []; } }

/** 「選択肢」シートからプルダウンの候補を読む（なければ初期値） */
function getChoices_() {
  if (MEMO_['#choices']) return MEMO_['#choices'];
  try { const hit = cache_().get('choices'); if (hit) return (MEMO_['#choices'] = JSON.parse(hit)); } catch (e) { /* 読み直す */ }
  const out = getChoicesRaw_();
  MEMO_['#choices'] = out;
  try { cache_().put('choices', JSON.stringify(out), 300); } catch (e) { /* 何もしない */ }
  return out;
}
function getChoicesRaw_() {
  let v = [];
  try { v = ss_().getSheetByName('選択肢').getDataRange().getValues(); } catch (e) { v = []; }
  const head = v.length ? v[0].map(function (x) { return String(x).trim(); }) : [];
  const out = {};
  Object.keys(DEFAULT_CHOICES).forEach(function (k) {
    const j = head.indexOf(k), list = [];
    if (j >= 0) for (let i = 1; i < v.length; i++) { const s = String(v[i][j]).trim(); if (s) list.push(s); }
    out[k] = list.length ? list : DEFAULT_CHOICES[k];
  });
  return out;
}
function getTools_() {
  try { return Object.assign({}, DEFAULT_TOOLS, JSON.parse(PropertiesService.getScriptProperties().getProperty('TOOLS') || '{}')); }
  catch (e) { return DEFAULT_TOOLS; }
}

function nextId_(data, idCol, prefix) {
  let max = 0;
  for (let i = 1; i < data.length; i++) {
    const m = String(data[i][idCol]).match(/(\d+)$/);
    if (m) max = Math.max(max, Number(m[1]));
  }
  return prefix + String(max + 1).padStart(4, '0');
}
function headOf_(data) { return data[0].map(function (h) { return String(h).trim(); }); }
function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}
function sheet_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('シート「' + name + '」が見つかりません。');
  return sh;
}
function diff_(head, before, row, skip) {
  const changes = [];
  head.forEach(function (h, j) {
    if (skip.indexOf(h) >= 0) return;
    const a = before ? String(norm_(before[j])).replace(/^'/, '') : '';
    const b = String(norm_(row[j])).replace(/^'/, '');
    if (a !== b) changes.push(h + '：' + (a || '（空）') + '→' + (b || '（空）'));
  });
  return changes;
}

/** IDで1行を追加・更新する（同時保存は順番待ち） */
function upsert_(sheetName, id, obj, prefix, me, pjId) {
  return withLock_(function () {
    const sh = sheet_(sheetName);
    const data = sh.getDataRange().getValues();
    const head = headOf_(data);
    const idCol = head.indexOf('ID'), pjCol = head.indexOf('PJ ID');
    let r = -1;
    if (id) {
      for (let i = 1; i < data.length; i++) { if (String(data[i][idCol]) === String(id)) { r = i; break; } }
      if (r < 0) throw new Error('この行が見つかりませんでした。ほかの人が削除した可能性があります。画面を更新してください。');
      if (String(data[r][pjCol]) !== String(pjId)) throw new Error('別のプロジェクトの行は編集できません。');
    }
    const newId = id || nextId_(data, idCol, prefix);
    obj['ID'] = newId;
    const before = r >= 0 ? data[r] : null;
    const row = head.map(function (h, j) { return (h in obj) ? toCell_(obj[h]) : (before ? before[j] : ''); });
    const changes = diff_(head, before, row, ['ID', 'PJ ID', '更新者', '更新日時'].concat(head.filter(function (h) { return !(h in obj); })));
    if (r >= 0) sh.getRange(r + 1, 1, 1, head.length).setValues([row]);
    else sh.getRange(data.length + 1, 1, 1, head.length).setValues([row]);
    if (r < 0 || changes.length) log_(me, sheetName, newId, r >= 0 ? '更新' : '追加', changes.join(' ／ '));
    invalidate_(sheetName, pjId);
    return newId;
  });
}

/**
 * まとめて追加・更新する（貼り付け・一括変更・ふつうの保存すべて）
 * list: [{ id: 既存ならID／新規なら空, obj: {見出し: 値} }]  → 戻り値：IDの配列（list と同じ順）
 */
function upsertMany_(sheetName, list, prefix, me, pjId) {
  if (!list.length) return [];
  return withLock_(function () {
    const sh = sheet_(sheetName);
    const data = sh.getDataRange().getValues();
    const head = headOf_(data);
    const idCol = head.indexOf('ID'), pjCol = head.indexOf('PJ ID');
    const index = {};
    let max = 0;
    for (let i = 1; i < data.length; i++) {
      const id = String(data[i][idCol]);
      if (id) index[id] = i;
      const m = id.match(/(\d+)$/); if (m) max = Math.max(max, Number(m[1]));
    }
    const ids = [], adds = [], upd = {}, logs = [];
    list.forEach(function (it) {
      let r = -1;
      if (it.id) {
        r = index[String(it.id)];
        if (r === undefined) throw new Error('行が見つかりませんでした。ほかの人が削除した可能性があります。画面を更新してください。');
        if (String(data[r][pjCol]) !== String(pjId)) throw new Error('別のプロジェクトの行は編集できません。');
      }
      const newId = it.id || prefix + String(++max).padStart(4, '0');
      it.obj['ID'] = newId;
      const before = r >= 0 ? data[r] : null;
      const row = head.map(function (h, j) { return (h in it.obj) ? toCell_(it.obj[h]) : (before ? before[j] : ''); });
      const changes = diff_(head, before, row, ['ID', 'PJ ID', '更新者', '更新日時'].concat(head.filter(function (h) { return !(h in it.obj); })));
      if (r >= 0) { data[r] = row; upd[r] = true; } else { adds.push(row); index[newId] = -1; }
      if (r < 0 || changes.length) logs.push([new Date(), me.email, sheetName, newId, r >= 0 ? '更新' : '追加', changes.join(' ／ ').slice(0, 500)]);
      ids.push(newId);
    });
    const rows = Object.keys(upd).map(Number).sort(function (a, b) { return a - b; });
    // 近い行はまとめて1回で書く（書く回数を減らす）
    let k = 0;
    while (k < rows.length) {
      let e = k;
      while (e + 1 < rows.length && rows[e + 1] - rows[e] <= 3) e++;
      const lo = rows[k], hi = rows[e];
      sh.getRange(lo + 1, 1, hi - lo + 1, head.length).setValues(data.slice(lo, hi + 1));
      k = e + 1;
    }
    if (adds.length) sh.getRange(data.length + 1, 1, adds.length, head.length).setValues(adds);
    logMany_(logs);
    invalidate_(sheetName, pjId);
    MEMO_[sheetName] = tableFromValues_(data.concat(adds));
    return ids;
  });
}

/** まとめて削除する */
function removeMany_(sheetName, ids, me, pjId, labelCol) {
  if (!ids.length) return 0;
  return withLock_(function () {
    const sh = sheet_(sheetName);
    const data = sh.getDataRange().getValues();
    const head = headOf_(data);
    const idCol = head.indexOf('ID'), pjCol = head.indexOf('PJ ID'), lc = head.indexOf(labelCol);
    const want = {}; ids.forEach(function (id) { want[String(id)] = true; });
    const hit = [], logs = [];
    for (let i = 1; i < data.length; i++) {
      if (!want[String(data[i][idCol])]) continue;
      if (String(data[i][pjCol]) !== String(pjId)) throw new Error('別のプロジェクトの行は削除できません。');
      hit.push(i);
      logs.push([new Date(), me.email, sheetName, String(data[i][idCol]), '削除', lc >= 0 ? String(data[i][lc]).slice(0, 500) : '']);
    }
    // 下の行から、続いている行はまとめて消す
    const left = data.filter(function (r, i) { return i === 0 || hit.indexOf(i) < 0; });
    let k = hit.length - 1;
    while (k >= 0) {
      let s = k;
      while (s - 1 >= 0 && hit[s - 1] === hit[s] - 1) s--;
      sh.deleteRows(hit[s] + 1, hit[k] - hit[s] + 1);
      k = s - 1;
    }
    logMany_(logs);
    invalidate_(sheetName, pjId);
    MEMO_[sheetName] = tableFromValues_(left);
    return hit.length;
  });
}

/** IDで1行を削除する */
function remove_(sheetName, id, me, pjId, labelCol) {
  return withLock_(function () {
