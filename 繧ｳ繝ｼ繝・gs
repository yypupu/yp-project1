function today_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }
function addDays_(n) { const d = new Date(); d.setDate(d.getDate() + n); return Utilities.formatDate(d, tz_(), 'yyyy-MM-dd'); }
/** いろいろな書き方の日付を 2026-11-03 の形にそろえる（読めなければそのまま） */
function dateStr_(v) {
  const s = String(v === null || v === undefined ? '' : v).replace(/^'/, '').trim();
  if (!s) return '';
  let m = s.match(/^(\d{4})\s*[-\/.年]\s*(\d{1,2})\s*[-\/.月]\s*(\d{1,2})/);
  if (m) return m[1] + '-' + String(m[2]).padStart(2, '0') + '-' + String(m[3]).padStart(2, '0');
  m = s.match(/^(\d{1,2})\s*[\/月]\s*(\d{1,2})\s*日?\s*(?:[(（].*)?$/);
  if (m) {
    const t = today_().split('-').map(Number);
    let y = t[0];
    const diff = (Date.UTC(y, +m[1] - 1, +m[2]) - Date.UTC(t[0], t[1] - 1, t[2])) / 86400000;
    if (diff < -180) y++;
    return y + '-' + String(m[1]).padStart(2, '0') + '-' + String(m[2]).padStart(2, '0');
  }
  return s;
}
function daysLeft_(s) {
  s = dateStr_(s);
  if (!s) return null;
  const m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return null;
  const t = today_().split('-').map(Number);
  return Math.round((Date.UTC(+m[1], +m[2] - 1, +m[3]) - Date.UTC(t[0], t[1] - 1, t[2])) / 86400000);
}
function whoIncludes_(who, name) {
  return String(who || '').split(/[,、\s]+/).some(function (x) { return x === name || x === 'ALL'; });
}
function normName_(s) { return String(s || '').normalize('NFKC').replace(/\s+/g, '').toLowerCase(); }

/** 表の1行を画面用の形にする */
function clean_(key, r) {
  const t = TABLES[key];
  const o = { id: String(r['ID'] || '') };
  Object.keys(t.fields).forEach(function (k) {
    let v = r[t.fields[k]];
    v = (v === undefined || v === null) ? '' : v;
    if ((t.nums || []).indexOf(k) >= 0) o[k] = v === '' ? '' : (Number(v) || 0);
    else if ((t.bools || []).indexOf(k) >= 0) o[k] = String(v).toUpperCase() === 'TRUE';
    else if ((t.dates || []).indexOf(k) >= 0) o[k] = dateStr_(v);
    else o[k] = String(v).replace(/^'/, '');
  });
  return o;
}
function rowsFor_(key, pjId) {
