/* ---------- Googleフォームの取り込み ---------- */
const FORM_COL = { guest: '参加者申込フォームの回答シートURL', staff: '運営メンバー申込フォームの回答シートURL', survey: 'アンケートフォームの回答シートURL' };
/**
 * フォームの回答を「1行目＝見出し、2行目から回答」の表として読む。
 * ・Googleフォームの編集画面のURL（…/forms/d/…/edit）→ Y-PUがそのフォームの編集者なら読める
 * ・回答シート（スプレッドシート）のURL → Y-PUがそのシートを見られれば読める
 */
function formValues_(url) {
  url = String(url || '').trim();
  if (/forms\.gle\/|\/forms\/d\/e\//.test(url)) {
    throw new Error('これは回答する人に送るURLです。フォームの編集画面のURL（docs.google.com/forms/d/…/edit）を貼ってください。');
  }
  if (/\/forms\//.test(url)) {
    let f;
    try { f = FormApp.openByUrl(url); }
    catch (e) { throw new Error('フォームを開けませんでした。Y-PUのアカウントがこのフォームの「編集者」になっているか確認してください。'); }
    const skip = [FormApp.ItemType.SECTION_HEADER, FormApp.ItemType.PAGE_BREAK, FormApp.ItemType.IMAGE, FormApp.ItemType.VIDEO];
    const items = f.getItems().filter(function (it) { return skip.indexOf(it.getType()) < 0; });
    const head = ['タイムスタンプ'].concat(items.map(function (it) { return it.getTitle(); }));
    const flat = function (v) { return Array.isArray(v) ? v.map(flat).filter(String).join(', ') : String(v === null || v === undefined ? '' : v); };
    const rows = f.getResponses().map(function (r) {
      const byId = {};
      r.getItemResponses().forEach(function (ir) { byId[ir.getItem().getId()] = flat(ir.getResponse()); });
      return [Utilities.formatDate(r.getTimestamp(), tz_(), 'yyyy-MM-dd HH:mm')].concat(items.map(function (it) { return byId[it.getId()] || ''; }));
    });
    return [head].concat(rows);
  }
  let book;
  try { book = SpreadsheetApp.openByUrl(url); }
  catch (e) { throw new Error('回答シートを開けませんでした。URLと、Y-PUのアカウントがそのスプレッドシートを見られるかを確認してください。'); }
  const gid = (url.match(/[#&?]gid=(\d+)/) || [])[1];
  const sheets = book.getSheets();
  const sh = (gid && sheets.filter(function (x) { return String(x.getSheetId()) === gid; })[0]) ||
    sheets.filter(function (x) { return /回答|Responses/i.test(x.getName()); })[0] || sheets[0];
  return sh.getDataRange().getDisplayValues();
}
function importFromSheet_(url, key, pjId, me) {
  const v = formValues_(url);
  if (v.length < 2) return 0;
  const head = v[0].map(function (h) { return String(h).trim(); });
  const find = function (re) { return head.findIndex(function (h) { return re.test(h); }); };
  const ni = find(/氏名|お名前|名前/), ui = find(/大学|学校/), gi = find(/学年/), ti = find(/チーム|希望/);
  if (ni < 0) throw new Error('フォームに「氏名」または「名前」という質問（列）が見つかりません。');
  const seen = {};
  rowsFor_(key, pjId).forEach(function (r) { seen[normName_(r.name)] = true; });
  const objs = [];
  for (let i = 1; i < v.length; i++) {
    const name = String(v[i][ni] || '').trim();
    if (!name || seen[normName_(name)]) continue;
    seen[normName_(name)] = true;
    const o = { 'PJ ID': pjId, '氏名': name, '大学': ui >= 0 ? v[i][ui] : '', '学年': gi >= 0 ? v[i][gi] : '' };
    if (key === 'guest') { o['参加状況'] = '申込'; o['受付'] = ''; o['追加元'] = 'フォーム'; }
    else { o['希望チーム'] = ti >= 0 ? v[i][ti] : ''; }
    objs.push(o);
  }
  return appendMany_(TABLES[key].sheet, objs, TABLES[key].prefix, me, 'フォームから' + objs.length + '件を取り込み');
}
function importForm(token, pjId, which) {
  pjId = String(pjId);
  const key = which === 'staff' ? 'staff' : 'guest';
  const me = check_(token, pjId, 'メンバー表').me;
