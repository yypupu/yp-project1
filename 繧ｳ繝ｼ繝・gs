/** 画面から来た1行分を、シートの見出し名のオブジェクトにする */
function buildObj_(t, key, item, me, pjId) {
  const obj = { 'PJ ID': pjId };
  Object.keys(t.fields).forEach(function (k) {
    if (!(k in item) || (t.readonly || []).indexOf(k) >= 0) return;
    let v = item[k];
    if ((t.nums || []).indexOf(k) >= 0) v = (v === '' || v === null) ? '' : Math.max(0, Math.round(Number(String(v).replace(/[,，¥￥円\s]/g, '')) || 0));
    else if ((t.bools || []).indexOf(k) >= 0) v = (v === true || /^(TRUE|済|○|◯|✓|✔|1|はい|yes)$/i.test(String(v).trim())) ? 'TRUE' : 'FALSE';
    else if ((t.times || []).indexOf(k) >= 0) v = timeCell_(v);
    else if ((t.dates || []).indexOf(k) >= 0) v = dateStr_(v);
    else v = String(v === null || v === undefined ? '' : v);
    obj[t.fields[k]] = v;
  });
  if (t.stamp) { obj['更新者'] = me.email; obj['更新日時'] = new Date(); }
  if (key === 'doc') obj['最終更新'] = today_();
  if (key === 'todo' && ('ステータス' in obj) && obj['ステータス'] && TODO_STATUS.indexOf(obj['ステータス']) < 0) delete obj['ステータス'];
  if (!item.id && t.onAdd) t.onAdd(obj, me, pjId);
