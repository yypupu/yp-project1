  const url = String(p[FORM_COL[key]] || '').trim();
  if (!url) throw new Error('フォームのURLがまだ登録されていません。「権限・連携」ページで登録してください。');
  const n = importFromSheet_(url, key, pjId, me);
  const out = getProject(token, pjId, ['guest', 'staff']);
  out.imported = n;
  return out;
}
