function summarize_(todos, atks, me) {
  const mine = todos.filter(function (t) { return t.status !== '完了' && whoIncludes_(t.who, me.name); });
  const late = mine.filter(function (t) { const n = daysLeft_(t.end); return n !== null && n < 0; }).length;
  const done = todos.filter(function (t) { return t.status === '完了'; }).length;
  const next = mine.filter(function (t) { return t.end; }).sort(function (a, b) { return a.end.localeCompare(b.end); })[0];
  const myAtk = atks.filter(function (a) { return a.who === me.name && ['参加確定', 'NG'].indexOf(a.status) < 0; }).length;
  return { myOpen: mine.length, myLate: late, total: todos.length, done: done, myAtk: myAtk, next: next ? { date: next.end, title: next.sub || next.group } : null };
}

